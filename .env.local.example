# Supabase (Auth + Postgres) — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create these 4 Prices under 2 Products ("SharpLine Plus", "SharpLine Pro") in
# the Stripe TEST dashboard — see ODDS_API_SETUP.md-style instructions in README.
NEXT_PUBLIC_STRIPE_PRICE_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PLUS_ANNUAL=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=

# Resend (https://resend.com) — only needed for email alerts (app/api/cron/alerts).
# Alerts silently no-op (log nothing sent) when left blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Protects /api/cron/* routes from being triggered by anyone but Vercel Cron.
# Vercel automatically sends this as a Bearer token when set — see vercel.json.
CRON_SECRET=

# Odds provider — "mock" (default, sample data) or "the-odds-api" (live data).
ODDS_PROVIDER=mock

# The Odds API (https://the-odds-api.com) — only needed when ODDS_PROVIDER=the-odds-api.
# Free tier: 500 credits/month. Cost per refresh = [sports] x [markets=3] x [regions],
# so the 2 sports/2 regions below cost 12 credits per refresh -> ~41 refreshes/month.
# ODDS_API_CACHE_SECONDS=3600 (1hr) keeps free-tier testing well under quota; repeated
# dashboard reloads within that hour are served from cache at no extra cost.
ODDS_API_KEY=
ODDS_API_SPORTS=americanfootball_nfl,basketball_nba
ODDS_API_REGIONS=us,eu
ODDS_API_CACHE_SECONDS=3600

# Opt-in player-prop markets added to the same bulk odds call, e.g.
# "player_pass_tds,player_points" — coverage varies by sport/bookmaker; unmatched
# lines are silently skipped. Each market adds to the per-refresh credit cost
# (markets x regions), so leave blank unless you need prop coverage.
ODDS_API_EXTRA_MARKETS=

# Priority-ordered sharp reference bookmaker keys (default "pinnacle"). The EV
# engine falls back to the next book in the list when a higher-priority one
# hasn't posted a line for a market, e.g.:
# ODDS_API_SHARP_BOOKS=pinnacle,circasports,betonlineag
ODDS_API_SHARP_BOOKS=pinnacle

# App config
NEXT_PUBLIC_APP_NAME=SharpLine
AGE_GATE_MINIMUM=21
