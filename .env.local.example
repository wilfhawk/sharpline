# Supabase (Auth + Postgres) — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# Odds provider — "mock" (default, sample data) or "the-odds-api" (live data).
ODDS_PROVIDER=mock

# The Odds API (https://the-odds-api.com) — only needed when ODDS_PROVIDER=the-odds-api.
# Free tier: 500 credits/month. Cost per refresh = [sports] x [markets=3] x [regions],
# so the 2 sports/2 regions below cost 12 credits per refresh -> ~41 refreshes/month.
# ODDS_API_CACHE_SECONDS=3600 (1hr) keeps free-tier testing well under quota; repeated
# dashboard reloads within that hour are served from cache at no extra cost.
ODDS_API_KEY=
ODDS_API_SPORTS=americanfootball_nfl,basketball_nba
ODDS_API_REGIONS=us,eu
ODDS_API_CACHE_SECONDS=3600

# App config
NEXT_PUBLIC_APP_NAME=SharpLine
AGE_GATE_MINIMUM=21
